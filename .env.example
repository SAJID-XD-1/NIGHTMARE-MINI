# Is file ko copy karke ".env" naam se save karein (sirf local PC ke liye).
# Heroku par ye values "Config Vars" mein daalni hoti hain.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nightmare
OWNER_NUMBER=923489890758
OWNER_NAME=Hajsajd
BOT_NAME=NIGHTMARE-MINI
PREFIX=.
TIMEZONE=Asia/Karachi
WARN_LIMIT=4
# Optional: menu ke saath image (direct link)
MENU_IMAGE=
# Optional AI keys (jo chahiye wahi daalein)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional: shuru ke SUDO numbers (comma se alag)
SUDO=
# Ek server par maximum kitne numbers pair ho sakte hain
MAX_SESSIONS=5
